<?xml version="1.0" encoding="utf-8"?>
<!--
  Rationale for minimal capabilities:
  - Only TYPE_WINDOW_STATE_CHANGED is needed: the service passes the foreground
    package name to the controller, which shows the overlay for non-HOME apps
    and hides it on HOME.
  - canRetrieveWindowContent = false: the app never reads another app's content
    (no text, no contentDescription, no AccessibilityNodeInfo).
  - canPerformGestures = false: no synthetic gestures required.
  If a future SystemUI strategy needs UI automation on a specific OEM settings
  screen, this file will be updated and the rationale recorded in README.md.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="false"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_service_description" />
